    { "id": "b7.bar_cap",            "type": "cadence", "tag": "[BAR]",             "max": 900, "window_min": 60, "enabled": true, "note": "B7-8 -- runaway guard; prints when a bar changes or hourly" },
    { "id": "b7.trial_size_cap",     "type": "cadence", "tag": "[TRIAL-SIZE]",      "max": 100, "window_min": 60, "enabled": true, "note": "B7-14/15 -- runaway guard" },
    { "id": "b7.trial_cap",          "type": "cadence", "tag": "[TRIAL]",           "max": 100, "window_min": 60, "enabled": true, "note": "B7-14 -- runaway guard" },
    { "id": "b7.save_after_entry",   "type": "cadence", "tag": "[STATE] Save after entry failed", "max": 0, "window_min": 1440, "enabled": true, "note": "B7-1 -- should never print" },
    { "id": "b7.state_kept",         "type": "cadence", "tag": "[STATE] Kept state file", "max": 20, "window_min": 60, "enabled": true, "note": "B7-1 -- once per start" },
    { "id": "b7.external_adopted",   "type": "cadence", "tag": "[SYNC] .* opened outside the bot", "max": 20, "window_min": 1440, "enabled": true, "note": "B7-2 -- hand trades taken into the book" },
    { "id": "b7.external_streak",    "type": "cadence", "tag": "[STREAK] .* opened outside the bot", "max": 20, "window_min": 1440, "enabled": true, "note": "B7-2 -- hand trades kept out of the scorecards" },
    { "id": "b8.p1_ledger_fresh",    "type": "file_fresh", "file": "logs/p1_refusals/p1_*.jsonl", "window_min": 1440, "enabled": true, "note": "B8-7 -- every break check is recorded; BTC trades daily so the file is always fresh" },
    { "id": "b8.zero_pass_mark",     "type": "cadence", "tag": "second check reached the life-cycle step", "max": 0, "window_min": 1440, "enabled": true, "note": "B8-12 -- a council must never judge against a pass mark of 0" },
    { "id": "replayer.runs",        "type": "file_fresh", "file": "logs/replayer_arms_*.json", "window_min": 11520, "enabled": true, "note": "B8-9: threshold met 22 Sep; the weekly run writes the arms files; 8-day window so a weekly run never looks late" },
    { "id": "rl1.proposals_file",   "type": "file_fresh", "file": "logs/rl1_proposals.jsonl",  "window_min": 11520, "enabled": true, "note": "B8-9: the bandit stamps every run, so this proves it ran" }
  ]
