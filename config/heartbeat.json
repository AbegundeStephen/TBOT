    { "id": "death.no_1h_kills",    "type": "set",     "tag": "[MEASURE-8.4-DEATH]", "extract": "reason=", "forbidden": ["FAILED_BREAKOUT","RETEST_FAILED","REF_ROLE_FLIPPED"] },
    { "id": "noproof.per_cycle",    "type": "cadence", "tag": "[NO-PROOF]",        "min": 1,  "window_min": 15,   "per_asset": true, "when": "market_open" },
